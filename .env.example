# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Groq API key — get yours free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Deployment note ---
# On Hugging Face Spaces:  set secrets in Space Settings → Repository secrets
# On Streamlit Cloud:      set secrets in App Settings → Secrets (TOML format)
# In both cases, do NOT use a .env file — it won't be read at runtime.
